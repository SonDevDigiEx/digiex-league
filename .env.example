# Supabase project (Project Settings → API). Leave empty to run in local demo mode.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Usernames without "@" are signed in as <username>@<this domain>.
VITE_AUTH_EMAIL_DOMAIN=digiex.group
# Show the quick-pick demo account list in the login dialog.
VITE_SHOW_DEMO_ACCOUNTS=false

# Only for scripts/create-users.ts (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=123456
